{
  "name": "quant-strategy-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "量化策略中枢 - Milestone 2 read-only data layer (Vue 3 + TS + Vite + TanStack Query + Zod)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:prod-isolation": "node scripts/check-prod-mock.cjs"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.101.4",
    "echarts": "^5.5.1",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/test-utils": "^2.4.6",
    "@playwright/test": "^1.45.3",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.0.29"
  }
}
